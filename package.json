{
  "name": "benchgo",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "bin": {
    "benchgo": "./bin/benchgo.mjs"
  },
  "description": "BenchGo plugin, voice and paired remote clients for the official DeepSeek Harness",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./plugins/benchgo/cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "setup": "node scripts/harness.mjs install",
    "build": "node scripts/harness.mjs build",
    "dev": "node scripts/desktop/prepare-dev.mjs",
    "start": "node scripts/harness.mjs start:desktop",
    "dev:web": "node scripts/harness.mjs dev:web",
    "start:web": "node scripts/harness.mjs start:web",
    "experience": "node scripts/experience.mjs",
    "typecheck": "node scripts/harness.mjs typecheck",
    "lint": "node scripts/harness.mjs lint",
    "package:dir": "node scripts/harness.mjs package:desktop:dir",
    "package:mac:arm64": "node scripts/harness.mjs package:desktop:mac:arm64",
    "package:mac:x64": "node scripts/harness.mjs package:desktop:mac:x64",
    "package:win:x64": "node scripts/harness.mjs package:desktop:win:x64",
    "check": "node scripts/harness.mjs check",
    "commander": "node plugins/benchgo/src/cli.mjs",
    "test:commander": "npm --prefix plugins/benchgo test",
    "test:harness": "node --import ./scripts/source-loader.mjs --test plugins/harness/test/*.test.mjs",
    "test:superagent": "node --import ./scripts/source-loader.mjs --test plugins/superagent/test/*.test.mjs",
    "test:voice": "node --import ./scripts/source-loader.mjs --test plugins/voice/test/*.test.mjs",
    "build:voice": "npm --prefix plugins/benchgo run build:client",
    "test:link": "npm --prefix plugins/link test",
    "build:plus": "npm --prefix plugins/benchgo run build:client",
    "build:android": "node scripts/build-link-android.mjs",
    "package:plus:win": "node scripts/desktop/package-windows.mjs",
    "benchgo": "node plugins/benchgo/src/cli.mjs",
    "package:plus:plugin": "node scripts/desktop/package-plugin-update.mjs",
    "reload:plus": "node scripts/reload-plus-client.mjs",
    "release:plan": "node scripts/release/plan.mjs"
  }
}
