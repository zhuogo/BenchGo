{
  "openapi": "3.1.0",
  "info": {
    "title": "BenchGo 设备中心",
    "version": "1.0.0",
    "description": "本机 owner 使用 launch 一次性入口获取私有会话路径。设备 token、SSH 密码和私钥不在公开响应暴露。MCP delegation 不变，不开放 Agent 设备切换或 SSH 工具。已配对工作台的 Link 会话接口除 Harness 操作外支持 notifications、notificationAck、notificationRead：通知以设备 ID 为投递目标，支持游标同步、独立回执与断线恢复；传输接收不等于设备回执。自有中继首版为单主机独占 HTTPS 源，TLS 在用户中继终止，中继运营者可读取内容；不增加 MCP 管理工具。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}/s/{session}",
      "variables": {
        "port": {
          "default": "0",
          "description": "运行时分配环回端口"
        },
        "session": {
          "default": "REDACTED",
          "description": "一次性入口签发的私有会话路径"
        }
      }
    }
  ],
  "paths": {
    "/link/api/info": {
      "servers": [{ "url": "/" }],
      "get": {
        "summary": "设备信息与配对后的选路更新",
        "description": "公开请求返回现有设备信息。发送已批准设备的 Bearer 凭据时，返回可核对的 hostId、hostName 和最新 routes，客户端在认证通过且身份一致时更新目录。历史单地址配对继续可用。",
        "responses": {
          "200": { "description": "设备信息。经认证时 routes 最多 16 条，含直连与按优先级使用的中继。" },
          "401": { "description": "设备凭据无效或已撤销。" }
        }
      }
    },
    "/link/workbench/api/commander/assistant": {
      "post": {
        "summary": "已配对设备的总助手通知与会话接口",
        "description": "仅接受工作台 HttpOnly 会话。除官方助手操作外，Link 允许 notifications（全局 seq 游标增量同步）、notificationAck（设备收件回执）和 notificationRead（助手已读状态）。notifications 返回后服务端记录 transport-delivered；客户端确认用户已看到后再提交 notificationAck。afterSeq 是全局通知序号，不是 thread 局部游标；断线重连应使用上次返回的 cursor。",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkbenchAssistantRequest" } } } },
        "responses": { "200": { "description": "助手操作结果或通知增量。", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } }, "400": { "description": "请求无效。" }, "401": { "description": "工作台会话失效。" } }
      }
    },
    "/link/workbench/device-center/api/devices": {
      "servers": [{ "url": "/" }],
      "post": {
        "summary": "已配对工作台的设备中心",
        "description": "使用工作台 HttpOnly 会话。设备列表返回主机和确认配对的设备概要。中继支持读取、测试、启停和首选设置，保存沿用带指纹的配置事务。hostRelayOperation 按原 requestId 查询同一设备的回执。",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["action"], "properties": { "action": { "enum": ["list", "hostStatus", "hostRelayTest", "hostRelayPoolConfigure", "hostRelayOperation"] }, "id": { "type": "string" }, "operation": { "enum": ["update", "prefer"] }, "enabled": { "type": "boolean" }, "requestId": { "type": "string" }, "expected": { "$ref": "#/components/schemas/RelayPoolExpected" } } } } } },
        "responses": { "200": { "description": "设备概要、中继状态、检测结果或管理回执。" }, "401": { "description": "工作台会话失效。" }, "403": { "description": "操作须由目标设备本机完成。" }, "409": { "description": "配置版本或请求意图冲突。" } }
      }
    },
    "/api/devices": {
      "post": {
        "summary": "设备保存、配对、切换与服务器管理",
        "x-action-responses": {
          "devices": { "$ref": "#/components/schemas/DeviceDirectory" },
          "resources": { "$ref": "#/components/schemas/ResourceAggregate" },
          "resourceScope": { "type": "object", "required": ["scope"], "properties": { "scope": { "$ref": "#/components/schemas/ResourceScope" } } },
          "setResourceScope": { "type": "object", "required": ["scope"], "properties": { "scope": { "$ref": "#/components/schemas/ResourceScope" } } },
          "sessionAction": { "$ref": "#/components/schemas/SessionActionReceipt" }
        },
        "x-device-naming": "rename 的 deviceId=local 修改本机持久名称并用于配对身份；其他设备 rename 仅保存本机管理备注，不修改被控端。hostRenameDevice 的 id/name 对已授权访问本机的设备保存本地备注，对应 owner rename-device；hostStatus.devices 的 name 显示备注，originalName 保留设备原始身份名。list 本机行返回真实名称。已批准配对返回 hostName 和 name（均为被控主机名称）；缺少名称生成稳定随机名。设备连接持久开启，hostConfigure.enabled 仅为旧客户端兼容字段，不再关闭连接。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "list:{devices,activeId,capabilities}; pair:{requestId,expiresAt}; pairStatus:{status,device?,direction?}。节点宿主批准后返回 direction 为 mutual、local-unavailable、remote-unavailable、source-unavailable 或 unreachable。select:{device,url}; sshProbe:{fingerprint}; sshConnect/reconnect/update:{jobId}; job:{id,state,steps,device?,error?}; serverAction:{operation,status?,logs?}; serverTerminal:{id,title}; serverTerminalRead:{output,offset,closed}; serverPairing:{code,expiresAt,mode,url,uri,webUrl}; serverPairingStatus:{pending}; serverPairingConfigure、serverPairingDecide 与终端写入/调整尺寸/关闭返回 {ok:true}。hostRelayTest:{ok,latencyMs,message}（只读测试，不保存输入、不抢占在线控制通道；id 节点 token 留空时复用私密配置）"
          },
          "400": {
            "description": "输入错误或操作失败"
          },
          "401": {
            "description": "身份或入口过期"
          },
          "403": {
            "description": "来源未授权"
          }
        },
        "description": "请求 Origin 必须等于设备中心源。sshProbe 不发送认证，sshConnect 必须包含用户确认的原始 SHA256 fingerprint。select 返回一次性工作台 URL。移除只删除本机连接，不卸载服务器。Android 原生还支持 closeWorkbench 关闭本机页面；Node 由前端关闭 iframe。Android 任务终态为 completed/failed。list.capabilities.hostAdmin 表示允许管理当前主机连接；hostStatus/hostConfigure/hostPairing/hostConfirm/hostReject/hostRevoke 为受限 owner 调用。配对 uri 接受完整 dshlink://pair 或 HTTPS /link/#code=...。SSH 任务在 TLS 指纹、设备令牌及真实 HTML 工作台验证成功后才注册设备。relayProbe/relayDeploy/relayAction 仅支持能力 relayDeploy 的 owner 桌面设备中心；部署成功自动保存并启用指定节点，job.relay 不含密钥。hostRelayPoolConfigure 使用 expected.fingerprint，按 id 执行 add/update/remove/prefer，状态不回显 token。hostPairing 的 relayId 可指定生成连接信息的在线中继。relayAction operation 为 status/logs/start/stop/restart/renew/renew-status/diagnose/uninstall；diagnose 返回脱敏诊断日志，renew-status 返回自动续期 timer 状态。已批准配对通过认证的 /link/api/info 同步 routes；连接顺序为直连后按中继优先级尝试，证书异常或授权失败不降级，活动请求不重放。"
      }
    },
    "/api/commander-devices": {
      "servers": [
        {
          "url": "/"
        }
      ],
      "post": {
        "summary": "官方 owner 通道：设备目录、资源查询与显示范围",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "enum": ["launch", "devices", "select", "resources", "resourceScope", "setResourceScope", "sessionAction"]
                  },
                  "parentOrigin": {
                    "type": "string"
                  },
                  "deviceId": { "type": "string" },
                  "expectedHostId": { "type": ["string", "null"] },
                  "expectedAuthorizationId": { "type": ["string", "null"] },
                  "id": { "type": "string", "maxLength": 256 },
                  "native": { "type": "boolean" },
                  "operation": { "enum": ["pin", "unpin", "archive", "unarchive", "rename", "delete", "fork"] },
                  "requestId": { "type": "string", "maxLength": 200 },
                  "title": { "type": "string", "maxLength": 200 },
                  "deviceIds": { "type": "array", "maxItems": 33, "items": { "type": "string" } },
                  "kind": { "$ref": "#/components/schemas/ResourceKind" },
                  "projectId": { "type": "string" },
                  "offset": { "type": "integer", "minimum": 0, "maximum": 100000 },
                  "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
                  "resource": { "$ref": "#/components/schemas/OpenResource" },
                  "scope": { "$ref": "#/components/schemas/ResourceScope" }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "launch返回一次性入口{url}；devices返回{activeId,devices}；resources返回{devices:[ResourcePage],partial}；resourceScope/setResourceScope返回{scope}；select返回{device,url,resource?}。",
            "content": { "application/json": { "schema": { "anyOf": [ { "$ref": "#/components/schemas/DeviceDirectory" }, { "$ref": "#/components/schemas/ResourceAggregate" }, { "$ref": "#/components/schemas/SessionActionReceipt" }, { "type": "object", "properties": { "scope": { "$ref": "#/components/schemas/ResourceScope" }, "url": { "type": ["string", "null"] }, "device": { "$ref": "#/components/schemas/Device" }, "resource": { "$ref": "#/components/schemas/OpenResource" } } } ] } } }
          },
          "400": {
            "description": "输入错误或操作失败"
          },
          "401": {
            "description": "身份或入口过期"
          },
          "403": {
            "description": "来源未授权"
          }
        },
        "description": "仅官方owner共享Fetch通道；身份由宿主browserPeer绑定，JSON不能自报owner。launch返回隔离入口；devices是出站目录，不是入站授权列表。resources有界并发、分页、超时与部分失败；范围只改变侧栏显示，不缩减助手授权。deviceId为local表示工作台所属主机，activeId仅是连接选择记录。setResourceScope只保存本项。远程设备继续使用独立设备认证，不转发owner会话。"
      }
    },
    "/api/commander-link": {
      "servers": [
        {
          "url": "/"
        }
      ],
      "post": {
        "summary": "Owner Link 管理",
        "description": "仅官方 owner 通道。status 返回 Link 与中继状态，不返回设备令牌或中继密钥。pairing.mode 支持 relay，relayId 可指定在线节点。relay-pool-configure 使用 status.relay.fingerprint 并按 id 执行 add/update/remove/prefer。新增、换址或换密钥经可信 HTTPS、中继协议和 HTTP/2 验证；换址须明确提交密钥，停用后可删除。已保存配置优先于启动环境变量 DSH_LINK_RELAY_URL/TOKEN，token 仅写入 0600 配置。中继状态返回 preferredId、selectedId、fingerprint、nodes；各节点含连接状态、错误与 checkedAt。部署与中继管理不新增 MCP。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "action"
                    ],
                    "properties": {
                      "action": {
                        "enum": [
                          "status",
                          "configure",
                          "pairing",
                          "confirm",
                          "reject",
                          "revoke",
                          "rename-device",
                          "relay-test",
                          "relay-pool-configure"
                        ]
                      },
                      "url": {
                        "type": "string"
                      },
                      "token": {
                        "type": "string",
                        "writeOnly": true
                      },
                      "enabled": {
                        "type": "boolean"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "description": "configure 更新本机持久名称，status.hostName 及批准配对的 hostName/name 返回此名称。"
                      },
                      "host": {
                        "type": "string"
                      },
                      "port": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 65535
                      },
                      "publicUrl": {
                        "type": "string"
                      },
                      "mode": {
                        "enum": [
                          "lan",
                          "public",
                          "relay"
                        ]
                      },
                      "address": {
                        "type": "string"
                      },
                      "id": {
                        "type": "string"
                      },
                      "operationId": { "type": "string" },
                      "allow": { "type": "boolean" },
                      "operation": { "enum": ["add", "update", "remove", "prefer"] },
                      "expected": { "$ref": "#/components/schemas/RelayPoolExpected" },
                      "relayId": { "type": "string" }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "当前 Link 与中继状态；relay-test 返回 {ok,latencyMs,message}，五秒无响应报告超时。验证可信 HTTPS、中继协议、密钥和 HTTP/2，独立于实际工作台访问。输入 url/token，地址保持一致时可带 id 并留空 token 复用私密配置。测试不保存输入、不回显密钥。"
          },
          "400": {
            "description": "输入无效、配置错误或服务关闭"
          },
          "401": {
            "description": "需要 owner 身份"
          },
          "403": {
            "description": "owner 权限或来源无效"
          }
        }
      }
    },
    "/link/api/rpc": {
      "post": {
        "summary": "配对工作台会话与通知 RPC",
        "description": "仅配对设备工作台会话可调用；afterSeq 是总助手通知的全局 seq 游标，按 threadId/unread 过滤后仍推进全局游标，客户端必须保存返回 cursor。notifications 返回后仅表示传输已接收；notificationAck 是设备级收件回执，notificationRead 是共享用户已读状态。断线后使用上次 cursor 增量同步。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "anyOf": [ { "$ref": "#/components/schemas/LinkSessionRequest" }, { "$ref": "#/components/schemas/DirectedDeviceInput" } ] }
            }
          }
        },
        "responses": {
          "200": {
            "description": "会话、模型或通知操作结果",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LinkSessionResponse" } } }
          },
          "400": { "description": "请求无效或操作失败" },
          "401": { "description": "设备会话无效或已过期" },
          "403": { "description": "设备未获准访问" },
          "409": { "description": "请求标识冲突" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RelayPoolExpected": { "type": "object", "required": ["fingerprint"], "properties": { "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false },
      "ResourceKind": { "enum": ["projects", "sessions", "recent", "models", "capabilities", "tasks"], "description": "tasks需目标真实适配器；当前未提供时明确UNSUPPORTED，不能将错误当空集合。旧目标recent语义不可核实时不回退全会话。" },
      "ResourceScope": {
        "type": "object", "required": ["mode", "deviceIds"], "additionalProperties": false,
        "properties": { "mode": { "enum": ["current", "all", "selected"] }, "deviceIds": { "type": "array", "maxItems": 33, "uniqueItems": true, "items": { "type": "string" } } }
      },
      "OpenResource": {
        "type": "object", "required": ["kind", "resourceId"],
        "properties": { "deviceId": { "type": "string" }, "kind": { "enum": ["projects", "sessions"] }, "resourceId": { "type": "string", "minLength": 1, "maxLength": 200 } }
      },
      "DeviceDirectory": {
        "type": "object", "required": ["activeId", "devices"],
        "properties": { "activeId": { "type": "string" }, "devices": { "type": "array", "maxItems": 33, "items": { "allOf": [ { "$ref": "#/components/schemas/Device" }, { "type": "object", "properties": { "direction": { "enum": ["local", "outbound"] }, "hostId": { "type": ["string", "null"] }, "authorizationId": { "type": ["string", "null"] }, "observedAt": { "type": "integer" } } } ] } } }
      },
      "ResourceSummary": {
        "type": "object", "required": ["deviceId", "kind", "resourceId"],
        "description": "有界白名单摘要，按deviceId+kind+resourceId归属；ID按不透明标识原样保留。项目可含name/title/path/sessionIds/isDefault；会话可含projectId/title/running/updatedAt/archived/pinned/native/ungrouped/engine/status；模型只返回标识和可用性，不含凭据。",
        "properties": { "deviceId": { "type": "string" }, "kind": { "$ref": "#/components/schemas/ResourceKind" }, "resourceId": { "type": "string" } }, "additionalProperties": true
      },
      "ResourcePage": {
        "type": "object", "required": ["deviceId", "available", "code", "reason", "observedAt", "freshness", "items", "offset", "limit", "hasMore"],
        "properties": {
          "deviceId": { "type": "string" }, "available": { "type": "boolean" }, "code": { "type": "string" }, "reason": { "type": ["string", "null"] },
          "observedAt": { "type": ["integer", "null"], "description": "最近成功查询的入口观察时间；失败不能刷新成当前时间。" },
          "attemptedAt": { "type": "integer" }, "lastSuccessfulAt": { "type": "integer" }, "freshness": { "enum": ["fresh", "stale", "unknown"] },
          "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/ResourceSummary" } },
          "offset": { "type": "integer", "minimum": 0 }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 }, "total": { "type": "integer", "minimum": 0 }, "hasMore": { "type": "boolean" },
          "hostId": { "type": ["string", "null"] }, "protocolVersion": { "type": "integer" }
        },
        "description": "仅available=true且items为空表示查询成功且范围内无资源。OFFLINE表示网络不可达，UNAUTHORIZED表示授权失效，IDENTITY_CHANGED表示身份或证书异常，UNSUPPORTED表示能力不支持，QUERY_FAILED表示业务或响应错误；业务错误不将设备标为离线。认证请求成功会恢复设备目录的可连接状态，取消不改可达状态。短暂查询失败可保留stale摘要；未授权、身份变化或设备移除立即清除此设备全部缓存，items为空且freshness=unknown。"
      },
      "ResourceAggregate": { "type": "object", "required": ["devices", "partial"], "properties": { "devices": { "type": "array", "maxItems": 33, "items": { "$ref": "#/components/schemas/ResourcePage" } }, "partial": { "type": "boolean" } } },
      "ManagementOperation": {
        "type": "object", "required": ["id", "operationId", "requestId", "deviceId", "namespace", "expected", "ops", "state", "createdAt"],
        "properties": {
          "id": { "type": "string" }, "operationId": { "type": "string" }, "requestId": { "type": "string" }, "deviceId": { "type": "string" },
          "namespace": { "const": "benchgo-link-relay" }, "expected": { "type": "object", "required": ["fingerprint"], "properties": { "fingerprint": { "type": "string" } } },
          "ops": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/components/schemas/RelayManagementOp" } },
          "state": { "enum": ["applying", "applied", "failed", "unknown", "expired", "rejected", "revoked"] },
          "createdAt": { "type": "integer" },
          "result": { "type": "object", "additionalProperties": true }, "error": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" } } }
        },
        "description": "按认证设备绑定，请求 ID 与精确差异作为幂等依据。已配对设备提交后直接经配置事务保存。applied 表示配置已保存，result.application 描述运行状态。断线后按原请求 ID 或回执 ID 查询。最多保留 128 条，容量满时先淘汰已结束记录。重启遇执行中回执标 unknown，历史待确认回执标 expired，均不自动重放。"
      },
      "RelayManagementOp": {
        "type": "object", "required": ["op", "path", "value"], "additionalProperties": false,
        "properties": { "op": { "const": "set" }, "path": { "type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [ { "const": "nodes" }, { "type": "string", "pattern": "^[0-9]+$" }, { "enum": ["priority", "enabled"] } ], "items": false }, "value": { "oneOf": [ { "type": "boolean" }, { "type": "integer", "minimum": 0, "maximum": 1000000 } ] } },
        "description": "仅已有中继节点；priority值为整数，enabled值为boolean；不得增删节点、地址或秘密。"
      },
      "SessionActionReceipt": {
        "type": "object", "required": ["accepted", "id", "operation", "requestId", "refreshRequired"],
        "properties": { "accepted": { "const": true }, "id": { "type": "string" }, "operation": { "enum": ["pin", "unpin", "archive", "unarchive", "rename", "delete", "fork"] }, "requestId": { "type": "string" }, "refreshRequired": { "const": true }, "deleted": { "type": "boolean" }, "title": { "type": "string" } },
        "description": "有限会话管理确认。入口请求必须绑定deviceId与所显示的expectedHostId/expectedAuthorizationId，未知身份显式null；expected字段不发往目标。native按真实来源明示，官方不透明ID不按前缀猜测。requestId使用sa:<毫秒时间戳>:<UUID>，按配对设备绑定完整意图；七天/最多2000条有界持久回执，过期重投拒绝，部分成功或回执不明返回待核实且不重放。收到匹配确认后入口刷新权威摘要。"
      },
      "DirectedDeviceInput": {
        "type": "object", "required": ["action"],
        "properties": { "action": { "enum": ["state", "models", "create", "history", "send", "cancel", "respond", "resources", "execution", "management", "sessionAction"] }, "id": { "type": "string", "maxLength": 256 }, "native": { "type": "boolean" }, "title": { "type": "string", "maxLength": 200 }, "operation": { "type": "string" }, "requestId": { "type": "string", "maxLength": 200 }, "operationId": { "type": "string" }, "kind": { "anyOf": [{ "$ref": "#/components/schemas/ResourceKind" }, { "enum": ["revision", "context", "answer"] }] }, "namespace": { "enum": ["benchgo-link-relay", "benchgo-link-transport"] }, "expected": { "type": "object", "properties": { "fingerprint": { "type": "string" } } }, "ops": { "type": "array", "maxItems": 20, "items": { "$ref": "#/components/schemas/RelayManagementOp" } } },
        "additionalProperties": true,
        "description": "确认配对允许目标实际支持的 BenchGo 能力。management 支持 status、relay-test、settings-read、settings-apply、operation。settings-apply 仅修改已有中继的 priority 和 enabled，operation 按 requestId 或 operationId 查询持久回执。执行入口绑定 expectedHostId/expectedAuthorizationId 并验证回执身份。sessionAction 按显式 native 和原始 id 选择适配器，请求 ID 绑定完整意图。目标从认证配对记录确定 principal。"
      },
      "RemoteExecutionRequest": {
        "type": "object", "required": ["action", "version", "operation"],
        "properties": {
          "action": { "const": "execution" }, "version": { "const": 1 },
          "operation": { "enum": ["catalog", "submit", "get", "input", "control", "ack"] },
          "requestId": { "type": "string", "maxLength": 512 }, "executionId": { "type": "string", "maxLength": 512 }, "sessionId": { "type": "string", "maxLength": 512 },
          "identity": { "type": "object", "required": ["ownerHostId", "taskId", "assignmentId", "runId", "fence"], "properties": { "ownerHostId": { "type": "string" }, "taskId": { "type": "string" }, "assignmentId": { "type": "string" }, "runId": { "type": "string" }, "fence": { "type": "integer", "minimum": 1 } } },
          "config": { "type": "object", "required": ["harness", "models"], "properties": { "harness": { "const": "official" }, "models": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "object", "required": ["providerId", "modelId"], "properties": { "providerId": { "type": "string" }, "modelId": { "type": "string" }, "params": { "type": "object" } } } } } },
          "projectId": { "type": "string" }, "text": { "type": "string", "maxLength": 100000 }, "requirements": { "type": "object" },
          "kind": { "enum": ["revision", "context", "answer"] }, "instructionRevision": { "type": "integer", "minimum": 1 }, "questionId": { "type": "string" }, "answers": { "type": "array", "items": { "type": "object" } },
          "control": { "enum": ["pause", "resume", "cancel"] }, "after": { "type": "integer", "minimum": 0 }, "limit": { "type": "integer", "minimum": 1, "maximum": 200 }, "through": { "type": "integer", "minimum": 0 }
        },
        "description": "submit由业务宿主预生成executionId/sessionId，携带完整identity、要求版本和冻结授权/模型；目标以认证principal一对一绑定ownerHostId，重复requestId只取原回执，改变命令主体冲突，after/limit不属于幂等意图。input初始received不代表应用；官方pre-step后的instruction.applied包含requestId/kind/实际instructionRevision。answer按当前questionId及逐题真实id回传。get按连续事件seq分页；result须含真实官方turn/end完成原因及transcript证据；ack仅确认已持久接收的事件水位，不重跑Worker。"
      },
      "DeviceRequest": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "enum": [
              "list",
              "pair",
              "pairStatus",
              "select",
              "rename",
              "remove",
              "sshProbe",
              "sshConnect",
              "serverPrefetch",
              "jobCancel",
              "job",
              "reconnect",
              "serverAction",
              "serverTerminal", "serverTerminalRead", "serverTerminalWrite", "serverTerminalResize", "serverTerminalClose",
              "serverPairing", "serverPairingConfigure", "serverPairingStatus", "serverPairingDecide",
              "hostStatus",
              "hostConfigure",
              "hostPairing",
              "hostConfirm",
              "hostReject",
              "hostRevoke",
              "hostRenameDevice",
              "relayProbe",
              "relayDeploy",
              "relayAction",
              "hostRelayTest",
              "hostRelayPoolConfigure",
