{
  "openapi": "3.1.0",
  "info": {
    "title": "BenchGo 设备中心",
    "version": "1.0.0",
    "description": "本机 owner 使用 launch 一次性入口获取私有会话路径。设备 token、SSH 密码和私钥不在公开响应暴露。MCP delegation 不变，不开放 Agent 设备切换或 SSH 工具。已配对工作台的 Link 会话接口除 Harness 操作外支持 notifications、notificationAck、notificationRead：通知以设备 ID 为投递目标，支持游标同步、独立回执与断线恢复；传输接收不等于设备回执。自有中继首版为单主机独占 HTTPS 源，TLS 在用户中继终止，中继运营者可读取内容；不增加 MCP 管理工具。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}/s/{session}",
      "variables": {
        "port": {
          "default": "0",
          "description": "运行时分配环回端口"
        },
        "session": {
          "default": "REDACTED",
          "description": "一次性入口签发的私有会话路径"
        }
      }
    }
  ],
  "paths": {
    "/link/workbench/api/commander/assistant": {
      "post": {
        "summary": "已配对设备的总助手通知与会话接口",
        "description": "仅接受工作台 HttpOnly 会话。除官方助手操作外，Link 允许 notifications（全局 seq 游标增量同步）、notificationAck（设备收件回执）和 notificationRead（助手已读状态）。notifications 返回后服务端记录 transport-delivered；客户端确认用户已看到后再提交 notificationAck。afterSeq 是全局通知序号，不是 thread 局部游标；断线重连应使用上次返回的 cursor。",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkbenchAssistantRequest" } } } },
        "responses": { "200": { "description": "助手操作结果或通知增量。", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } }, "400": { "description": "请求无效。" }, "401": { "description": "工作台会话失效。" } }
      }
    },
    "/api/devices": {
      "post": {
        "summary": "设备保存、配对、切换与服务器管理",
        "x-action-responses": {
          "devices": { "$ref": "#/components/schemas/DeviceDirectory" },
          "resources": { "$ref": "#/components/schemas/ResourceAggregate" },
          "resourceScope": { "type": "object", "required": ["scope"], "properties": { "scope": { "$ref": "#/components/schemas/ResourceScope" } } },
          "setResourceScope": { "type": "object", "required": ["scope"], "properties": { "scope": { "$ref": "#/components/schemas/ResourceScope" } } },
          "hostGrantDevice": { "type": "object", "properties": { "devices": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "capabilities": { "type": "array", "items": { "enum": ["collaboration", "management"] } } } } }, "pendingManagement": { "type": "array", "items": { "$ref": "#/components/schemas/ManagementOperation" } } } },
          "hostManagementDecide": { "$ref": "#/components/schemas/ManagementOperation" }
        },
        "x-device-naming": "rename 的 deviceId=local 修改本机持久名称并用于配对身份；其他设备 rename 仅保存本机管理备注，不修改被控端。hostRenameDevice 的 id/name 对已授权访问本机的设备保存本地备注，对应 owner rename-device；hostStatus.devices 的 name 显示备注，originalName 保留设备原始身份名。list 本机行返回真实名称。已批准配对返回 hostName 和 name（均为被控主机名称）；缺少名称生成稳定随机名。设备连接持久开启，hostConfigure.enabled 仅为旧客户端兼容字段，不再关闭连接。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "list:{devices,activeId,capabilities}; pair:{requestId,expiresAt}; pairStatus:{status,device?}; select:{device,url}; sshProbe:{fingerprint}; sshConnect/reconnect/update:{jobId}; job:{id,state,steps,device?,error?}; serverAction:{operation,status?,logs?}; hostRelayTest:{ok,latencyMs,message}（只读测试，不保存输入、不抢占在线控制通道；id 节点 token 留空时复用私密配置）"
          },
          "400": {
            "description": "输入错误或操作失败"
          },
          "401": {
            "description": "身份或入口过期"
          },
          "403": {
            "description": "来源未授权"
          }
        },
        "description": "请求 Origin 必须等于设备中心源。sshProbe 不发送认证，sshConnect 必须包含用户确认的原始 SHA256 fingerprint。select 返回一次性工作台 URL。移除只删除本机连接，不卸载服务器。 Android 原生还支持 closeWorkbench 关闭本机页面；Node 由前端关闭 iframe。Android 任务终态为 completed/failed。 list.capabilities.hostAdmin 表示允许管理当前主机连接；hostStatus/hostConfigure/hostPairing/hostConfirm/hostReject/hostRevoke 为受限 owner 调用。配对 uri 接受完整 dshlink://pair 或 HTTPS /link/#code=...。SSH 任务在 TLS 指纹、设备令牌及真实 HTML 工作台验证成功后才注册设备。 relayProbe/relayDeploy/relayAction 仅支持能力 relayDeploy 的 owner 桌面设备中心；部署成功自动保存并启用主机连接，job.relay 不含密钥。hostRelayConfigure 接收 url/token/enabled，状态不回显 token。relayAction operation 为 status/logs/start/stop/restart/renew/renew-status/diagnose/uninstall；diagnose 返回脱敏诊断日志，renew-status 返回自动续期 timer 状态。已批准配对的 routes 支持 relayId、priority、health、cooldownUntil 和 lastError；连接顺序固定为直连后按中继优先级尝试，冷却节点跳过，证书异常或授权失败不降级，活动请求不重放。历史单地址配对保持兼容，重新配对获取 routes。"
      }
    },
    "/api/commander-devices": {
      "servers": [
        {
          "url": "/"
        }
      ],
      "post": {
        "summary": "官方 owner 通道：设备目录、资源查询与显示范围",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "enum": ["launch", "devices", "select", "resources", "resourceScope", "setResourceScope"]
                  },
                  "parentOrigin": {
                    "type": "string"
                  },
                  "deviceId": { "type": "string" },
                  "deviceIds": { "type": "array", "maxItems": 33, "items": { "type": "string" } },
                  "kind": { "$ref": "#/components/schemas/ResourceKind" },
                  "projectId": { "type": "string" },
                  "offset": { "type": "integer", "minimum": 0, "maximum": 100000 },
                  "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
                  "resource": { "$ref": "#/components/schemas/OpenResource" },
                  "scope": { "$ref": "#/components/schemas/ResourceScope" }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "launch返回一次性入口{url}；devices返回{activeId,devices}；resources返回{devices:[ResourcePage],partial}；resourceScope/setResourceScope返回{scope}；select返回{device,url,resource?}。",
            "content": { "application/json": { "schema": { "anyOf": [ { "$ref": "#/components/schemas/DeviceDirectory" }, { "$ref": "#/components/schemas/ResourceAggregate" }, { "type": "object", "properties": { "scope": { "$ref": "#/components/schemas/ResourceScope" }, "url": { "type": ["string", "null"] }, "device": { "$ref": "#/components/schemas/Device" }, "resource": { "$ref": "#/components/schemas/OpenResource" } } } ] } } }
          },
          "400": {
            "description": "输入错误或操作失败"
          },
          "401": {
            "description": "身份或入口过期"
          },
          "403": {
            "description": "来源未授权"
          }
        },
        "description": "仅官方owner共享Fetch通道；身份由宿主browserPeer绑定，JSON不能自报owner。launch返回隔离入口；devices是出站目录，不是入站授权列表。resources有界并发、分页、超时与部分失败；范围只改变侧栏显示，不缩减助手授权。deviceId为local表示工作台所属主机，activeId仅是连接选择记录。setResourceScope只保存本项。远程设备继续使用独立设备认证，不转发owner会话。"
      }
    },
    "/api/commander-link": {
      "servers": [
        {
          "url": "/"
        }
      ],
      "post": {
        "summary": "Owner Link 管理",
        "description": "仅官方 owner 通道。status 返回 Link 与中继状态，不返回设备令牌或中继密钥。pairing.mode 支持 relay：仅通道在线时签发中继 HTTPS 配对地址；通过 DSH_LINK_RELAY_URL/TOKEN 配置主机出站连接，密钥不在响应暴露。relay-configure 为 owner 显式保存 url/token/enabled，优先于启动环境变量；token 仅写入 0600 配置，状态返回 relay:{configured,enabled,url,connected,lastError}，不回显 token。部署与中继管理不新增 MCP。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "action"
                    ],
                    "properties": {
                      "action": {
                        "enum": [
                          "status",
                          "configure",
                          "pairing",
                          "confirm",
                          "reject",
                          "revoke",
                          "rename-device",
                          "relay-configure",
                          "relay-test",
                          "relay-pool-configure", "grant-device", "management-decide"
                        ]
                      },
                      "url": {
                        "type": "string"
                      },
                      "token": {
                        "type": "string",
                        "writeOnly": true
                      },
                      "enabled": {
                        "type": "boolean"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "description": "configure 更新本机持久名称，status.hostName 及批准配对的 hostName/name 返回此名称。"
                      },
                      "host": {
                        "type": "string"
                      },
                      "port": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 65535
                      },
                      "publicUrl": {
                        "type": "string"
                      },
                      "mode": {
                        "enum": [
                          "lan",
                          "public",
                          "relay"
                        ]
                      },
                      "address": {
                        "type": "string"
                      },
                      "id": {
                        "type": "string"
                      },
                      "collaboration": { "type": "boolean" },
                      "management": { "type": "boolean" },
                      "operationId": { "type": "string" },
                      "allow": { "type": "boolean" },
                      "nodes": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "当前 Link 与中继状态；relay-test 返回 {ok,latencyMs,message}，失败仍返回 200，五秒无响应报告超时；验证可信 HTTPS、中继协议和密钥，不代表隧道或访问端已在线。输入 url/token，编辑可带 id 并留空 token 复用私密配置；不保存输入、不回显密钥。GET /__link/relay/probe 为只读 Bearer 鉴权探测，要求 {protocol:benchgo-link-relay,version:1,authenticated:true}；旧中继无此能力时需升级，普通 HTTP 可达不算成功。"
          },
          "400": {
            "description": "输入无效、配置错误或服务关闭"
          },
          "401": {
            "description": "需要 owner 身份"
          },
          "403": {
            "description": "owner 权限或来源无效"
          }
        }
      }
    },
    "/link/api/rpc": {
      "post": {
        "summary": "配对工作台会话与通知 RPC",
        "description": "仅配对设备工作台会话可调用；afterSeq 是总助手通知的全局 seq 游标，按 threadId/unread 过滤后仍推进全局游标，客户端必须保存返回 cursor。notifications 返回后仅表示传输已接收；notificationAck 是设备级收件回执，notificationRead 是共享用户已读状态。断线后使用上次 cursor 增量同步。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "anyOf": [ { "$ref": "#/components/schemas/LinkSessionRequest" }, { "$ref": "#/components/schemas/DirectedDeviceInput" } ] }
            }
          }
        },
        "responses": {
          "200": {
            "description": "会话、模型或通知操作结果",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LinkSessionResponse" } } }
          },
          "400": { "description": "请求无效或操作失败" },
          "401": { "description": "设备会话无效或已过期" },
          "403": { "description": "设备未获准访问" },
          "409": { "description": "请求标识冲突" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResourceKind": { "enum": ["projects", "sessions", "recent", "models", "capabilities", "tasks"], "description": "tasks需目标真实适配器；当前未提供时明确UNSUPPORTED，不能将错误当空集合。旧目标recent语义不可核实时不回退全会话。" },
      "ResourceScope": {
        "type": "object", "required": ["mode", "deviceIds"], "additionalProperties": false,
        "properties": { "mode": { "enum": ["current", "all", "selected"] }, "deviceIds": { "type": "array", "maxItems": 33, "uniqueItems": true, "items": { "type": "string" } } }
      },
      "OpenResource": {
        "type": "object", "required": ["kind", "resourceId"],
        "properties": { "deviceId": { "type": "string" }, "kind": { "enum": ["projects", "sessions"] }, "resourceId": { "type": "string", "minLength": 1, "maxLength": 200 } }
      },
      "DeviceDirectory": {
        "type": "object", "required": ["activeId", "devices"],
        "properties": { "activeId": { "type": "string" }, "devices": { "type": "array", "maxItems": 33, "items": { "allOf": [ { "$ref": "#/components/schemas/Device" }, { "type": "object", "properties": { "direction": { "enum": ["local", "outbound"] }, "hostId": { "type": ["string", "null"] }, "authorizationId": { "type": ["string", "null"] }, "observedAt": { "type": "integer" } } } ] } } }
      },
      "ResourceSummary": {
        "type": "object", "required": ["deviceId", "kind", "resourceId"],
        "description": "有界白名单摘要，按deviceId+kind+resourceId归属；ID按不透明标识原样保留。项目可含name/title/path/sessionIds/isDefault；会话可含projectId/title/running/updatedAt/archived/pinned/native/ungrouped/engine/status；模型只返回标识和可用性，不含凭据。",
        "properties": { "deviceId": { "type": "string" }, "kind": { "$ref": "#/components/schemas/ResourceKind" }, "resourceId": { "type": "string" } }, "additionalProperties": true
      },
      "ResourcePage": {
        "type": "object", "required": ["deviceId", "available", "code", "reason", "observedAt", "freshness", "items", "offset", "limit", "hasMore"],
        "properties": {
          "deviceId": { "type": "string" }, "available": { "type": "boolean" }, "code": { "type": "string" }, "reason": { "type": ["string", "null"] },
          "observedAt": { "type": ["integer", "null"], "description": "最近成功查询的入口观察时间；失败不能刷新成当前时间。" },
          "attemptedAt": { "type": "integer" }, "lastSuccessfulAt": { "type": "integer" }, "freshness": { "enum": ["fresh", "stale", "unknown"] },
          "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/ResourceSummary" } },
          "offset": { "type": "integer", "minimum": 0 }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 }, "total": { "type": "integer", "minimum": 0 }, "hasMore": { "type": "boolean" },
          "hostId": { "type": ["string", "null"] }, "protocolVersion": { "type": "integer" }
        },
        "description": "仅available=true且items为空表示查询成功且范围内无资源。OFFLINE表示网络不可达，UNAUTHORIZED表示授权失效，IDENTITY_CHANGED表示身份或证书异常，UNSUPPORTED表示能力不支持，QUERY_FAILED表示业务或响应错误；业务错误不将设备标为离线。认证请求成功会恢复设备目录的可连接状态，取消不改可达状态。短暂查询失败可保留stale摘要；未授权、身份变化或设备移除立即清除此设备全部缓存，items为空且freshness=unknown。"
      },
      "ResourceAggregate": { "type": "object", "required": ["devices", "partial"], "properties": { "devices": { "type": "array", "maxItems": 33, "items": { "$ref": "#/components/schemas/ResourcePage" } }, "partial": { "type": "boolean" } } },
      "ManagementOperation": {
        "type": "object", "required": ["id", "operationId", "requestId", "deviceId", "namespace", "expected", "ops", "state", "createdAt", "expiresAt"],
        "properties": {
          "id": { "type": "string" }, "operationId": { "type": "string" }, "requestId": { "type": "string" }, "deviceId": { "type": "string" }, "deviceName": { "type": "string" },
          "namespace": { "const": "benchgo-link-relay" }, "expected": { "type": "object", "required": ["fingerprint"], "properties": { "fingerprint": { "type": "string" } } },
          "ops": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/components/schemas/RelayManagementOp" } },
          "state": { "enum": ["pending", "applying", "applied", "failed", "unknown", "expired", "rejected", "revoked"] },
          "createdAt": { "type": "integer" }, "expiresAt": { "type": "integer" }, "requiresConfirmation": { "type": "boolean" },
          "result": { "type": "object", "additionalProperties": true }, "error": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" } } }
        },
        "description": "按认证device绑定，保留期内requestId+精确差异幂等；20分钟过期。target owner批准后CAS应用，断线查原operation，不重复提交。最多保留128条，容量满时先淘汰已结束或已过期记录；未决与unknown不自动删除。旧回执已淘汰时查询返回NOT_FOUND，不推断效果或自动重放。重启遇执行中记录标unknown，不自动重跑。hostStatus.pendingManagement仅返回仍待审批的非秘密摘要。"
      },
      "RelayManagementOp": {
        "type": "object", "required": ["op", "path", "value"], "additionalProperties": false,
        "properties": { "op": { "const": "set" }, "path": { "type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [ { "const": "nodes" }, { "type": "string", "pattern": "^[0-9]+$" }, { "enum": ["priority", "enabled"] } ], "items": false }, "value": { "oneOf": [ { "type": "boolean" }, { "type": "integer", "minimum": 0, "maximum": 1000000 } ] } },
        "description": "仅已有中继节点；priority值为整数，enabled值为boolean；不得增删节点、地址或秘密。"
      },
      "DirectedDeviceInput": {
        "type": "object", "required": ["action"],
        "properties": { "action": { "enum": ["state", "models", "create", "history", "send", "cancel", "respond", "resources", "collaboration", "management"] }, "operation": { "type": "string" }, "requestId": { "type": "string", "maxLength": 200 }, "operationId": { "type": "string" }, "kind": { "$ref": "#/components/schemas/ResourceKind" }, "namespace": { "enum": ["benchgo-link-relay", "benchgo-link-transport"] }, "expected": { "type": "object", "properties": { "fingerprint": { "type": "string" } } }, "ops": { "type": "array", "maxItems": 20, "items": { "$ref": "#/components/schemas/RelayManagementOp" } } },
        "additionalProperties": true,
        "description": "有限定向协议，不接受任意HTTP/SSH或owner action。collaboration只允许delegate/get/lookup/control/change且需显式collaboration grant；management只允许status/relay-test/settings-read/settings-prepare/operation且需独立management grant。settings-read支持transport/relay命名空间；settings-prepare仅relay既有节点priority/enabled，返回ManagementOperation等待目标真实主人审批；operation按operationId查同设备原申请。资源与原会话动作沿既有访问授权。目标从TLS认证绑定principal，JSON principal不能扩大权限。"
      },
      "DeviceRequest": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "enum": [
              "list",
              "pair",
              "pairStatus",
              "select",
              "rename",
              "remove",
              "sshProbe",
              "sshConnect",
              "job",
              "reconnect",
              "serverAction",
              "hostStatus",
              "hostConfigure",
              "hostPairing",
              "hostConfirm",
              "hostReject",
              "hostRevoke",
              "hostRenameDevice",
              "relayProbe",
              "relayDeploy",
              "relayAction",
              "hostRelayConfigure",
              "hostRelayTest",
              "hostRelayPoolConfigure",
              "devices", "resources", "resourceScope", "setResourceScope", "callDevice", "hostGrantDevice", "hostManagementDecide"
            ]
          },
          "deviceId": {
            "type": "string"
          },
          "deviceIds": { "type": "array", "maxItems": 33, "items": { "type": "string" } },
          "kind": { "$ref": "#/components/schemas/ResourceKind" },
          "projectId": { "type": "string" },
          "offset": { "type": "integer", "minimum": 0, "maximum": 100000 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "scope": { "$ref": "#/components/schemas/ResourceScope" },
          "resource": { "$ref": "#/components/schemas/OpenResource" },
          "collaboration": { "type": "boolean", "description": "hostPairing显式申请协作授权；hostGrantDevice按id升级或撤销既有入站授权，默认不授权。" },
          "management": { "type": "boolean", "description": "独立有限管理授权，不是owner权限。" },
          "operationId": { "type": "string" },
          "allow": { "type": "boolean", "description": "hostManagementDecide真实主人单次批准或拒绝精确配置差异。" },
          "input": { "$ref": "#/components/schemas/DirectedDeviceInput" },
          "jobId": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "default": 22,
            "description": "SSH 为 1–65535（默认22）；hostConfigure 为 0–65535，0分配随机端口。"
          },
          "username": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          },
          "privateKey": {
            "type": "string",
            "writeOnly": true
          },
          "passphrase": {
            "type": "string",
            "writeOnly": true
          },
          "source": {
            "enum": [
              "mirror",
              "github"
            ],
            "default": "mirror"
          },
          "operation": {
            "enum": [
              "status",
              "start",
              "stop",
              "restart",
              "logs",
              "renew",
              "renew-status",
              "diagnose",
              "uninstall",
              "update",
              "enable",
              "rotate",
              "disable"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "publicUrl": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "lan",
              "public",
              "relay"
            ]
          },
          "address": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "writeOnly": true,
            "minLength": 16,
            "maxLength": 512
          },
          "publicIp": {
            "type": "string",
            "description": "服务器公网 IP；无需域名"
          },
          "email": {
            "type": "string"
          },
          "relayPort": {
            "type": "integer",
            "minimum": 20000,
            "maximum": 49151
          },
          "challengeMode": {
            "enum": [
              "standalone",
              "webroot"
            ]
          },
          "webroot": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "token": {
            "type": "string",
            "writeOnly": true
          },
          "nodes": {
            "type": "array",
            "maxItems": 8,
            "description": "中继池有序节点；token 仅写入，不在响应返回。",
            "items": {
              "type": "object",
              "required": [
                "id",
                "url"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 128
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "token": {
                  "type": "string",
                  "writeOnly": true
                },
                "priority": {
                  "type": "integer",
                  "minimum": 0
                },
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "enum": [
                    "sshProbe",
                    "sshConnect"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "port": {
                  "minimum": 1
                }
              }
            }
          }
        ]
      },
      "WorkbenchAssistantRequest": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "type": "string", "enum": ["notifications", "notificationAck", "notificationRead"] },
          "afterSeq": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "threadId": { "type": "string", "maxLength": 200 },
          "unread": { "type": "boolean" },
          "eventIds": { "type": "array", "maxItems": 500, "items": { "type": "string", "maxLength": 200 } }
        },
        "additionalProperties": true
      },
      "Device": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "local",
              "computer",
              "ssh"
            ]
          },
          "url": {
            "type": "string"
          },
          "status": {
            "enum": [
              "unknown",
              "online",
              "offline"
            ]
          },
          "lastError": {
            "type": [
              "string",
              "null"
            ]
          },
          "warning": {
            "type": "string"
          }
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "running",
              "done",
              "error"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "running",
                    "done",
                    "error"
                  ]
                }
              }
            }
          },
          "device": {
            "$ref": "#/components/schemas/Device"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "LinkSessionRequest": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "enum": ["state", "models", "create", "history", "send", "cancel", "respond", "notifications", "notificationAck", "notificationRead"] },
          "id": { "type": "string" },
          "projectId": { "type": "string" },
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "requestId": { "type": "string", "maxLength": 200 },
          "text": { "type": "string", "maxLength": 20000 },
          "before": { "type": "integer", "minimum": 0 },
          "afterSeq": { "type": "integer", "minimum": 0, "description": "全局通知 seq 游标" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "threadId": { "type": "string" },
          "unread": { "type": "boolean" },
          "eventIds": { "type": "array", "items": { "type": "string" }, "maxItems": 500 },
          "interactionId": { "type": "string" },
          "answer": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      },
      "LinkSessionResponse": {
        "type": "object",
        "additionalProperties": true,
        "description": "按 action 返回；notifications 包含 events、cursor、hasMore、resyncRequired。"
      }
    }
  }
}
