          "kind": { "$ref": "#/components/schemas/ResourceKind" },
          "projectId": { "type": "string" },
          "offset": { "type": "integer", "minimum": 0, "description": "资源分页上限为 100000。终端读取使用上次返回的 offset。" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "scope": { "$ref": "#/components/schemas/ResourceScope" },
          "resource": { "$ref": "#/components/schemas/OpenResource" },
          "expectedHostId": { "type": ["string", "null"] },
          "expectedAuthorizationId": { "type": ["string", "null"] },
          "native": { "type": "boolean" },
          "title": { "type": "string", "maxLength": 200 },
          "expected": { "$ref": "#/components/schemas/RelayPoolExpected" },
          "relayId": { "type": "string" },
          "input": { "$ref": "#/components/schemas/DirectedDeviceInput" },
          "jobId": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "default": 22,
            "description": "SSH 为 1–65535（默认22）；hostConfigure 为 0–65535，0分配随机端口。"
          },
          "username": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          },
          "privateKey": {
            "type": "string",
            "writeOnly": true
          },
          "passphrase": {
            "type": "string",
            "writeOnly": true
          },
          "source": {
            "enum": [
              "mirror",
              "github"
            ],
            "default": "mirror"
          },
          "operation": {
            "enum": [
              "pin", "unpin", "archive", "unarchive", "rename", "delete", "fork",
              "add", "remove", "prefer",
              "status",
              "start",
              "stop",
              "restart",
              "logs",
              "renew",
              "renew-status",
              "diagnose",
              "uninstall",
              "update",
              "enable",
              "rotate",
              "disable"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "publicUrl": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "lan",
              "public",
              "relay"
            ]
          },
          "address": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "writeOnly": true,
            "minLength": 16,
            "maxLength": 512
          },
          "publicIp": {
            "type": "string",
            "description": "服务器公网 IP；无需域名"
          },
          "email": {
            "type": "string"
          },
          "relayPort": {
            "type": "integer",
            "minimum": 20000,
            "maximum": 49151
          },
          "challengeMode": {
            "enum": [
              "standalone",
              "webroot"
            ]
          },
          "webroot": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "token": {
            "type": "string",
            "writeOnly": true
          },
          "nodes": {
            "type": "array",
            "maxItems": 8,
            "description": "中继池有序节点；token 仅写入，不在响应返回。",
            "items": {
              "type": "object",
              "required": [
                "id",
                "url"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 128
                },
                "url": {
                  "type": "string",
