.ba-root:has(.ba-activity-panel){position:relative}
.ba-root .ba-activity-trigger{display:inline-flex;align-items:center;justify-content:center;gap:4px;flex:none;min-width:32px;min-height:32px;padding:4px;border:0;border-radius:6px;background:transparent;color:var(--ba-muted);cursor:pointer}
.ba-root .ba-activity-trigger:hover,.ba-root .ba-activity-trigger[aria-expanded=true]{background:var(--ba-active,rgba(128,128,128,.1))}
.ba-root .ba-activity-trigger:focus-visible{outline:2px solid currentColor;outline-offset:2px}
.ba-activity-count{font-size:11px;font-variant-numeric:tabular-nums}
.ba-activity-panel[hidden],.ba-activity-backdrop[hidden]{display:none!important}
.ba-activity-backdrop{display:none}
.ba-activity-panel{flex:0 0 320px;width:320px;min-width:0;min-height:0;border-left:1px solid var(--ba-line);display:flex;flex-direction:column;background:var(--dsw-alias-bg-base,#fff);outline:none}
.ba-activity-panel>header{display:flex;align-items:center;justify-content:space-between;padding:10px 16px;min-height:61px;gap:12px}
.ba-activity-panel>header>div{display:grid;gap:3px}.ba-activity-panel>header strong{font-size:14px;font-weight:600}.ba-activity-panel small{font-size:11px;color:var(--ba-muted)}
.ba-activity-filters{display:flex;gap:4px;padding:0 12px 12px;border-bottom:1px solid var(--ba-line)}
.ba-root .ba-activity-filters button{font-size:12px;border:0;min-height:30px;padding:4px 8px}.ba-activity-filters button[aria-pressed=true]{background:var(--ba-active)}.ba-activity-filters button:last-child{margin-left:auto;color:var(--ba-muted)}
.ba-activity-body{flex:1;min-height:0;overflow:auto;padding:0 16px 16px}.ba-activity-day h3{position:sticky;top:0;margin:0;padding:14px 0 8px;background:var(--dsw-alias-bg-base,#fff);font-size:12px;font-weight:500;color:var(--ba-muted)}
.ba-activity-panel .ba-activity-task{grid-template-columns:18px minmax(0,1fr);gap:6px 10px;padding:16px 8px;border-bottom:1px solid var(--ba-line);color:inherit}
.ba-activity-panel .ba-task-open{gap:4px;min-height:0;font:inherit}.ba-activity-panel .ba-task-open strong{font-size:14px;line-height:1.5;font-weight:600}.ba-activity-panel .ba-task-open>span{font-size:12px;line-height:1.5;color:var(--ba-muted)}
.ba-activity-panel .ba-task-row-actions{grid-column:2;justify-content:flex-end;gap:6px}.ba-activity-panel .ba-task-icon{width:30px!important;height:30px!important;min-height:30px!important;padding:6px!important}
.ba-activity-status{display:flex;align-items:center;justify-content:center;width:18px;height:22px;margin-top:2px;color:var(--ba-muted)}.ba-activity-status>span{width:12px;height:12px;border:1.5px solid currentColor;border-radius:50%;box-sizing:border-box}.ba-activity-status[data-status=claimed],.ba-activity-status[data-status=active]{color:var(--dsw-alias-brand-primary,#1d3f86)}.ba-activity-status[data-status=failed],.ba-activity-status[data-status=uncertain],.ba-activity-status[data-status=blocked]{color:var(--cmd-danger,#b74848)}
.ba-activity-meta{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-top:6px;font-size:11px;line-height:1.5;color:var(--ba-muted);font-variant-numeric:tabular-nums}
.ba-activity-detail{font-size:13px;line-height:1.65;color:var(--ba-muted)}.ba-activity-detail p{white-space:pre-wrap;overflow-wrap:anywhere}.ba-activity-detail>div{margin-top:4px}.ba-activity-empty{margin:28px 0;font-size:13px;color:var(--ba-muted)}.ba-activity-error{font-size:12px;color:#c84c52}
@media(pointer:coarse){.ba-activity-panel .ba-task-icon{width:44px!important;height:44px!important;min-height:44px!important}}

.ba-activity-panel>footer{display:flex;gap:8px;padding:12px;border-top:1px solid var(--ba-line)}.ba-root .ba-activity-panel>footer button{flex:none;width:32px;height:32px;padding:0;border:0;background:transparent}
.ba-activity-panel-icon{transform:scaleX(-1)}
.ba-root .ba-activity-panel>header .ba-icon{width:28px;height:28px;min-height:28px;padding:0;border:0;background:transparent;color:var(--ba-muted)}
@media(max-width:1000px){.ba-activity-panel{position:absolute;right:0;top:0;bottom:0;z-index:4;width:min(360px,100%);box-shadow:-8px 0 24px #0000000d}.ba-activity-backdrop{display:block;position:absolute;inset:0;background:#00000024;z-index:3}}
@media(max-width:520px){.ba-activity-panel{width:100%;border-left:0}.ba-root .ba-activity-panel button,.ba-root .ba-activity-trigger{min-height:44px}}
