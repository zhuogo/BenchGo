<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>BenchGo SuperAgent 全链路架构</title>
  <style>
    :root {
      --bg: #f5f7fb;
      --paper: #ffffff;
      --ink: #162033;
      --muted: #607089;
      --line: #c9d3e2;
      --blue: #2563eb;
      --blue-soft: #eaf2ff;
      --violet: #7c3aed;
      --violet-soft: #f1ebff;
      --green: #15803d;
      --green-soft: #eaf8ef;
      --amber: #b45309;
      --amber-soft: #fff4df;
      --red: #b42318;
      --red-soft: #fff0ee;
      --shadow: 0 18px 48px rgba(35, 54, 86, .10);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      color: var(--ink);
      background: radial-gradient(circle at 15% 0%, #eef4ff 0, transparent 36%), var(--bg);
      font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
    }
    .wrap { max-width: 1480px; margin: 0 auto; padding: 36px 28px 64px; }
    header { display: flex; justify-content: space-between; gap: 24px; align-items: end; margin-bottom: 24px; }
    h1 { margin: 0 0 8px; font-size: clamp(28px, 4vw, 48px); line-height: 1.05; letter-spacing: -.04em; }
    h2 { margin: 0 0 16px; font-size: 22px; letter-spacing: -.02em; }
    h3 { margin: 0 0 7px; font-size: 16px; }
    p { margin: 0 0 10px; }
    .subtitle { color: var(--muted); max-width: 800px; font-size: 16px; }
    .badge { display: inline-flex; align-items: center; gap: 7px; padding: 8px 12px; border-radius: 999px; background: #e8f8ee; color: #176b39; font-weight: 700; white-space: nowrap; }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: #21a65a; }
    .panel { background: rgba(255,255,255,.88); border: 1px solid #e2e8f2; border-radius: 22px; box-shadow: var(--shadow); padding: 24px; margin-top: 22px; }
    .architecture { overflow-x: auto; }
    svg { display: block; width: 100%; min-width: 1120px; height: auto; }
    .svg-title { font-size: 15px; font-weight: 800; fill: var(--ink); }
    .svg-label { font-size: 12px; fill: var(--ink); }
    .svg-small { font-size: 11px; fill: var(--muted); }
    .node { stroke-width: 1.4; }
    .node-blue { fill: var(--blue-soft); stroke: #8db6ff; }
    .node-violet { fill: var(--violet-soft); stroke: #b59af5; }
    .node-green { fill: var(--green-soft); stroke: #91d6a6; }
    .node-amber { fill: var(--amber-soft); stroke: #e8bb78; }
    .node-red { fill: var(--red-soft); stroke: #efaaa4; }
    .zone { fill: #fbfcfe; stroke: #dbe3ee; stroke-width: 1.2; stroke-dasharray: 5 5; }
    .flow { stroke: #4a6384; stroke-width: 2; fill: none; marker-end: url(#arrow); }
    .flow-dashed { stroke: #8292aa; stroke-width: 1.7; fill: none; stroke-dasharray: 6 5; marker-end: url(#arrow-muted); }
    .legend { display: flex; flex-wrap: wrap; gap: 10px 18px; color: var(--muted); font-size: 13px; margin-top: 12px; }
    .legend span { display: inline-flex; align-items: center; gap: 7px; }
    .swatch { width: 14px; height: 14px; border-radius: 4px; border: 1px solid; }
    .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
    .card { border: 1px solid #e2e8f2; border-radius: 16px; padding: 16px; background: #fff; }
    .card p { color: var(--muted); }
    .card ul { padding-left: 18px; margin: 8px 0 0; color: var(--muted); }
    .sequence { overflow-x: auto; }
    .seq-wrap { min-width: 1160px; }
    .seq-row { display: grid; grid-template-columns: 180px repeat(8, 1fr); align-items: center; min-height: 52px; border-bottom: 1px solid #edf1f6; }
    .seq-head { background: #f8fafc; border-radius: 12px 12px 0 0; border-top: 1px solid #edf1f6; }
    .seq-cell { padding: 9px 8px; text-align: center; font-size: 12px; color: var(--muted); border-left: 1px solid #edf1f6; min-height: 52px; display: flex; align-items: center; justify-content: center; }
    .seq-cell.actor { font-weight: 800; color: var(--ink); border-left: 0; }
    .seq-cell.action { color: var(--ink); font-weight: 650; position: relative; }
    .seq-cell.action::before { content: ""; position: absolute; left: -1px; right: -1px; top: 50%; border-top: 2px solid var(--blue); z-index: 0; }
    .seq-cell.action span { position: relative; z-index: 1; background: #fff; padding: 2px 5px; border-radius: 5px; }
    .step { display: inline-block; width: 22px; height: 22px; border-radius: 50%; background: var(--blue); color: #fff; line-height: 22px; font-weight: 800; margin-right: 5px; }
    .note { color: var(--muted); font-size: 13px; }
    .callout { border-left: 4px solid var(--blue); background: #f1f6ff; padding: 13px 15px; border-radius: 8px; color: #28456e; }
    footer { color: var(--muted); font-size: 13px; margin-top: 24px; }
    @media (max-width: 900px) { .wrap { padding: 24px 14px 44px; } header { display: block; } .badge { margin-top: 16px; } .grid { grid-template-columns: 1fr; } .panel { padding: 16px; } }
  </style>
</head>
<body>
  <main class="wrap">
    <header>
      <div>
        <h1>SuperAgent 全链路架构</h1>
        <p class="subtitle">先按噪音给入口分档（直通档 / 筛选档），再由 Router（总调度）统一派工、Worker（执行者）干活；上下文由专门一层负责装配、传递与清理；模型按角色分工：角色模型、工作模型、辅助模型。</p>
      </div>
      <div class="badge"><span class="dot"></span>本地闭环已具备 · 449/449 测试通过</div>
    </header>

    <section class="panel architecture">
      <h2>一、运行时总架构</h2>
      <svg viewBox="0 0 1400 1646" role="img" aria-label="SuperAgent 运行时总架构图">
        <defs>
          <marker id="arrow" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 z" fill="#4a6384"/></marker>
          <marker id="arrow-muted" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 z" fill="#8292aa"/></marker>
        </defs>

        <rect class="zone" x="18" y="18" width="1364" height="216" rx="18"/>
        <text class="svg-title" x="38" y="48">一、噪音与入口（按噪音高低分档，不按渠道分）</text>

        <rect class="node node-green" x="38" y="64" width="620" height="150" rx="14"/>
        <text class="svg-title" x="58" y="94">直通档 · 低噪音（用户主动输入）</text>
        <rect class="node node-blue" x="58" y="110" width="270" height="40" rx="10"/><text class="svg-label" x="193" y="135" text-anchor="middle">主聊天 / 旁聊（键盘输入）</text>
        <rect class="node node-blue" x="348" y="110" width="270" height="40" rx="10"/><text class="svg-label" x="483" y="135" text-anchor="middle">登记触发 · 去重留痕</text>
        <path class="flow" d="M328 130 H348"/>
        <text class="svg-label" x="58" y="182">用户主动发的消息：发送动作本身就是触发，不筛选、不研判，直达 Router。</text>

        <rect class="node node-amber" x="682" y="64" width="660" height="150" rx="14" style="stroke-dasharray:7 5"/>
        <text class="svg-title" x="702" y="94">筛选档 · 高噪音（外部事件触发）</text>
        <rect class="node node-blue" x="702" y="110" width="190" height="40" rx="10"/><text class="svg-label" x="797" y="135" text-anchor="middle">飞书 · 抓取 · 截图 · 系统事件</text>
        <rect class="node node-violet" x="912" y="110" width="130" height="40" rx="10"/><text class="svg-label" x="977" y="135" text-anchor="middle">归一 · 统一格式</text>
        <rect class="node node-violet" x="1062" y="110" width="110" height="40" rx="10"/><text class="svg-label" x="1117" y="135" text-anchor="middle">门卫 · 准入</text>
        <rect class="node node-violet" x="1192" y="110" width="140" height="40" rx="10"/><text class="svg-label" x="1262" y="135" text-anchor="middle">研判 · 接/挂/停/略</text>
        <path class="flow" d="M892 130 H912"/><path class="flow" d="M1042 130 H1062"/><path class="flow" d="M1172 130 H1192"/>
        <text class="svg-label" x="702" y="182">外部事件先归一成统一格式，再过门卫与研判；合格才汇入，原始消息流不进 Router。</text>

        <path class="flow" d="M348 214 V314"/>
        <text class="svg-small" x="358" y="272">直通直达</text>
        <path class="flow" d="M1000 214 V280 H658 V314"/>
        <text class="svg-small" x="760" y="272">合格候选汇入工单</text>

        <rect class="zone" x="18" y="262" width="1364" height="402" rx="18"/>
        <text class="svg-title" x="38" y="292">二、主会话与编排（Router 主引擎）</text>

        <rect class="node node-violet" x="38" y="318" width="430" height="170" rx="14"/>
        <text class="svg-title" x="58" y="350">Router · 总调度（自己不干活）</text>
        <text class="svg-label" x="58" y="378">· 与用户沟通的主要入口（主聊天 / 旁聊）</text>
        <text class="svg-label" x="58" y="402">· 只做信息处理：查工单进程、查工具运行、查账本</text>
        <text class="svg-label" x="58" y="426">· 分诊：直接回答 / 开单派工 / 拦截驳回</text>
        <text class="svg-label" x="58" y="450">· 执行一律派给 Worker，自己只调度、验收、交付</text>
        <text class="svg-label" x="58" y="474">· 随身文档：人设 · 身份 · 主人档案 · 做事规矩 · 记忆</text>

        <rect class="node node-amber" x="508" y="318" width="300" height="88" rx="12"/>
        <text class="svg-title" x="528" y="344">工单账本（标题 + 活摘要）</text>
        <text class="svg-label" x="528" y="366">标题开单生成 · 活摘要随进展更新</text>
        <text class="svg-label" x="528" y="388">状态机 · 派工 · 订阅 · 处置账 · 修订</text>

        <rect class="node node-amber" x="508" y="414" width="300" height="74" rx="12"/>
        <text class="svg-title" x="528" y="442">验收与交付</text>
        <text class="svg-label" x="528" y="468">Router 对照工单验收，合格才回主聊天交付</text>

        <rect class="node node-green" x="848" y="318" width="494" height="88" rx="12"/>
        <text class="svg-title" x="868" y="344">Worker 池 · 第 0 层主执行官</text>
        <text class="svg-label" x="868" y="366">凭单领活 · 隔离会话执行 · 干完即散 · 对工单结果负责</text>
        <text class="svg-label" x="868" y="388">向下委派与否由 Worker 按效率自主决定（只一层）</text>

        <rect class="node node-green" x="848" y="414" width="494" height="74" rx="12"/>
        <text class="svg-title" x="868" y="442">结果包（不直接交付用户）</text>
        <text class="svg-label" x="868" y="468">做了什么 · 证据在哪 · 未尽事项 → 先回 Router 验收</text>

        <path class="flow" d="M468 358 H508"/><path class="flow" d="M808 358 H848"/>
        <path class="flow" d="M1095 406 V410"/><path class="flow" d="M848 451 H812"/><path class="flow" d="M508 451 H472"/>
        <text class="svg-small" x="472" y="348">开单</text>
        <text class="svg-small" x="812" y="348">派工</text>

        <rect class="node node-amber" x="38" y="504" width="642" height="56" rx="12"/>
        <text class="svg-title" x="58" y="528">跟进消息先处置 · 默认挂靠原单</text>
        <text class="svg-label" x="58" y="550">补充 / 转向 → 原单修订；提问只答；超原授权先确认</text>

        <rect class="node node-amber" x="700" y="504" width="642" height="56" rx="12"/>
        <text class="svg-title" x="720" y="528">新建工单先查重（代码卡关）</text>
        <text class="svg-label" x="720" y="550">按标题 + 摘要查在办 / 刚关工单；同触发只生一单，重复单可合并</text>

        <rect class="node node-amber" x="38" y="576" width="420" height="64" rx="12"/>
        <text class="svg-title" x="58" y="602">执行中提问回路（卡片问用户）</text>
        <text class="svg-label" x="58" y="626">上报 Router → 卡片提问 → 答复回原单续跑</text>

        <rect class="node node-green" x="478" y="576" width="420" height="64" rx="12"/>
        <text class="svg-title" x="498" y="602">子代理（第 1 层）· 只许向下派一层</text>
        <text class="svg-label" x="498" y="626">结果先回 Worker 汇总 · 权限递减 · 问题逐级上报 · 不直接找用户</text>

        <rect class="node node-amber" x="918" y="576" width="424" height="64" rx="12"/>
        <text class="svg-title" x="938" y="602">交付后调整 · 新开关联调整单</text>
        <text class="svg-label" x="938" y="626">原单完成关账不回改 · Router 凭原单 + 结果包恢复上下文</text>

        <rect class="zone" x="18" y="692" width="1364" height="330" rx="18"/>
        <text class="svg-title" x="38" y="722">三、上下文管理层（管每个会话吃什么、吃多少）</text>

        <rect class="node node-blue" x="38" y="748" width="420" height="120" rx="12"/>
        <text class="svg-title" x="58" y="776">触发时机 · 什么时候装</text>
        <text class="svg-label" x="58" y="802">会话开局：先装配一份上下文，再开工</text>
        <text class="svg-label" x="58" y="828">每回合：按当前话题，临时补当轮材料</text>
        <text class="svg-label" x="58" y="854">主会话常驻不关：太长就压缩旧记录、无感轮换</text>

        <rect class="node node-blue" x="478" y="748" width="420" height="120" rx="12"/>
        <text class="svg-title" x="498" y="776">拼接逻辑 · 怎么拼</text>
        <text class="svg-label" x="498" y="802">固定层：随身文档整份装入，顺序固定</text>
        <text class="svg-label" x="498" y="828">近期层：最近一段对话的原文</text>
        <text class="svg-label" x="498" y="854">按需层：缺什么按编号去账本取原文，不全塞</text>

        <rect class="node node-blue" x="918" y="748" width="424" height="120" rx="12"/>
        <text class="svg-title" x="938" y="776">传递对象 · 给谁什么</text>
        <text class="svg-label" x="938" y="802">给 Router：全套——靠它理解需求、做派工</text>
        <text class="svg-label" x="938" y="828">给 Worker：只给任务包切片 + 原文指针，不读全套</text>
        <text class="svg-label" x="938" y="854">给辅助模型：只给要压缩、总结的那份材料</text>

        <rect class="node node-violet" x="38" y="884" width="830" height="110" rx="12"/>
        <text class="svg-title" x="58" y="912">Router 开局包 · 开局按序装入（只给 Router）</text>
        <text class="svg-label" x="58" y="938">① 系统指令本体 ② 运行时信息 ③ 文档链全文 ④ 对齐总结 ⑤ 关系索引（只给名单）</text>
        <text class="svg-label" x="58" y="964">⑥ 活跃目标摘要 ⑦ 能力目录（技能目录，连接器先留空位） ⑧ 保险库清单（只给名单） ⑨ 其他对话动态摘要 ⑩ 本会话窗口</text>

        <rect class="node node-violet" x="888" y="884" width="454" height="110" rx="12"/>
        <text class="svg-title" x="908" y="912">生成与维护 · 谁来写这些</text>
        <text class="svg-label" x="908" y="938">对齐总结：辅助模型按计数器后台重写，主模型兜底</text>
        <text class="svg-label" x="908" y="964">旁聊标题与摘要：辅助模型的活，异步生成、不堵对话</text>

        <path class="flow-dashed" d="M248 748 V668"/><path class="flow-dashed" d="M688 748 V668"/><path class="flow-dashed" d="M1130 748 V668"/>
        <text class="svg-small" x="258" y="714">全套</text>
        <text class="svg-small" x="698" y="714">账本可查</text>
        <text class="svg-small" x="1140" y="714">任务包切片</text>

        <rect class="zone" x="18" y="1050" width="1364" height="176" rx="18"/>
        <text class="svg-title" x="38" y="1080">四、模型层（按角色分工，各用各的模型）</text>
        <rect class="node node-violet" x="38" y="1106" width="420" height="90" rx="12"/>
        <text class="svg-title" x="58" y="1136">角色模型（对话模型）→ 供 Router</text>
        <text class="svg-label" x="58" y="1164">常驻在线：要稳、要便宜、理解与表达好</text>
        <rect class="node node-green" x="478" y="1106" width="420" height="90" rx="12"/>
        <text class="svg-title" x="498" y="1136">工作模型 → 供 Worker</text>
        <text class="svg-label" x="498" y="1164">干活时才点火：要强，按任务难度选档</text>
        <rect class="node node-blue" x="918" y="1106" width="424" height="90" rx="12"/>
        <text class="svg-title" x="938" y="1136">辅助模型 → 打杂</text>
        <text class="svg-label" x="938" y="1164">压缩、总结、看图等杂活：要快、要便宜</text>
        <path class="flow-dashed" d="M248 1106 V1026"/><path class="flow-dashed" d="M688 1106 V1026"/><path class="flow-dashed" d="M1130 1106 V1026"/>

        <rect class="zone" x="18" y="1254" width="660" height="196" rx="18"/>
        <text class="svg-title" x="38" y="1284">治理与资源边界（执行时由执行器统一安装）</text>
        <rect class="node node-red" x="38" y="1310" width="142" height="44" rx="10"/><text class="svg-label" x="109" y="1336" text-anchor="middle">权限门</text>
        <rect class="node node-red" x="198" y="1310" width="142" height="44" rx="10"/><text class="svg-label" x="269" y="1336" text-anchor="middle">保险库</text>
        <rect class="node node-red" x="358" y="1310" width="142" height="44" rx="10"/><text class="svg-label" x="429" y="1336" text-anchor="middle">目标与预算</text>
        <rect class="node node-red" x="518" y="1310" width="142" height="44" rx="10"/><text class="svg-label" x="589" y="1336" text-anchor="middle">密钥池</text>
        <rect class="node node-red" x="38" y="1372" width="142" height="44" rx="10"/><text class="svg-label" x="109" y="1398" text-anchor="middle">注意力请求</text>
        <rect class="node node-red" x="198" y="1372" width="142" height="44" rx="10"/><text class="svg-label" x="269" y="1398" text-anchor="middle">检查点</text>
        <rect class="node node-red" x="358" y="1372" width="142" height="44" rx="10"/><text class="svg-label" x="429" y="1398" text-anchor="middle">重试与恢复</text>
        <rect class="node node-red" x="518" y="1372" width="142" height="44" rx="10"/><text class="svg-label" x="589" y="1398" text-anchor="middle">看门狗</text>

        <rect class="zone" x="702" y="1254" width="680" height="196" rx="18"/>
        <text class="svg-title" x="722" y="1284">持久化与记忆（横向支撑）</text>
        <rect class="node node-violet" x="722" y="1310" width="200" height="44" rx="10"/><text class="svg-label" x="822" y="1336" text-anchor="middle">控制面数据库</text>
        <rect class="node node-violet" x="942" y="1310" width="200" height="44" rx="10"/><text class="svg-label" x="1042" y="1336" text-anchor="middle">会话与日志</text>
        <rect class="node node-violet" x="1162" y="1310" width="200" height="44" rx="10"/><text class="svg-label" x="1262" y="1336" text-anchor="middle">账本与原文检索</text>
        <rect class="node node-violet" x="722" y="1372" width="200" height="44" rx="10"/><text class="svg-label" x="822" y="1398" text-anchor="middle">文档记忆</text>
        <rect class="node node-violet" x="942" y="1372" width="200" height="44" rx="10"/><text class="svg-label" x="1042" y="1398" text-anchor="middle">复盘与学习</text>
        <rect class="node node-violet" x="1162" y="1372" width="200" height="44" rx="10"/><text class="svg-label" x="1262" y="1398" text-anchor="middle">技能库与候选审核</text>

        <rect class="zone" x="18" y="1478" width="1364" height="150" rx="18"/>
        <text class="svg-title" x="38" y="1508">配置与接入（横向支撑）</text>
