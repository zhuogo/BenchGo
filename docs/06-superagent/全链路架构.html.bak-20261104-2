        <rect class="node node-violet" x="668" y="668" width="190" height="48" rx="10"/><text class="svg-label" x="763" y="696" text-anchor="middle">Markdown 记忆</text>
        <rect class="node node-violet" x="878" y="668" width="190" height="48" rx="10"/><text class="svg-label" x="973" y="696" text-anchor="middle">Review / Learning</text>
