        <rect class="node node-red" x="38" y="504" width="142" height="44" rx="10"/><text class="svg-label" x="109" y="530" text-anchor="middle">Attention</text>
        <rect class="node node-red" x="198" y="504" width="142" height="44" rx="10"/><text class="svg-label" x="269" y="530" text-anchor="middle">Checkpoint</text>
        <rect class="node node-red" x="358" y="504" width="142" height="44" rx="10"/><text class="svg-label" x="429" y="530" text-anchor="middle">Retry / Resume</text>
        <rect class="node node-red" x="518" y="504" width="142" height="44" rx="10"/><text class="svg-label" x="589" y="530" text-anchor="middle">Watchdog</text>
        <path class="flow-dashed" d="M1278 168 V460 H678"/>

        <rect class="zone" x="702" y="382" width="680" height="200" rx="18"/>
