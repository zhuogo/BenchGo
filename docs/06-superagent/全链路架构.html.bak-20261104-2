        <rect class="node node-amber" x="820" y="116" width="140" height="40" rx="10"/><text class="svg-label" x="890" y="141" text-anchor="middle">Mandate / Assignment</text>

        <rect class="zone" x="1002" y="18" width="380" height="150" rx="18"/>
        <text class="svg-title" x="1022" y="48">执行边界</text>
        <rect class="node node-green" x="1022" y="64" width="160" height="40" rx="10"/><text class="svg-label" x="1102" y="89" text-anchor="middle">Assignment Worker</text>
        <rect class="node node-green" x="1198" y="64" width="160" height="40" rx="10"/><text class="svg-label" x="1278" y="89" text-anchor="middle">Executor</text>
